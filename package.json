{
  "name": "sudo-hire-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "node scripts/build-content.mjs --check && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "content": "node scripts/build-content.mjs",
    "format": "prettier --write src scripts tests *.json vite.config.ts .github",
    "format:check": "prettier --check src scripts tests *.json vite.config.ts .github"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.6.2",
    "remark-parse": "^11.0.0",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.0",
    "zod": "^4.1.0"
  }
}
